      "datasource": {
        "type": "scopedb-scopedb-datasource",
        "uid": "scopedb-bluesky"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "scopedb-scopedb-datasource",
            "uid": "scopedb-bluesky"
          },
          "modelVersion": 1,
          "queryText": "FROM bluesky_events\nWHERE $__timeFilter(time)\nAND collection = 'app.bsky.feed.post' AND operation = 'create'\nAGGREGATE count() AS posts, approx_count_distinct(actor_did) AS authors,\n sum(CASE (external_domain IS NOT NULL AND external_domain != '') WHEN true THEN 1 ELSE 0 END) AS posts_with_links,\n sum(CASE (language IS NOT NULL AND language != '') WHEN true THEN 1 ELSE 0 END) AS language_tagged"
        }
      ]
    },
