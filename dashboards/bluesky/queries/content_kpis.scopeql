FROM bluesky_events
WHERE $__timeFilter(time)
AND collection = 'app.bsky.feed.post' AND operation = 'create'
AGGREGATE count() AS posts, approx_count_distinct(actor_did) AS authors,
 sum(CASE (external_domain IS NOT NULL AND external_domain != '') WHEN true THEN 1 ELSE 0 END) AS posts_with_links,
 sum(CASE (language IS NOT NULL AND language != '') WHEN true THEN 1 ELSE 0 END) AS language_tagged
