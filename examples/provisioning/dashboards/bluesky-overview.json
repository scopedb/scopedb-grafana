      "datasource": {
        "type": "scopedb-scopedb-datasource",
        "uid": "scopedb-bluesky"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "scopedb-scopedb-datasource",
            "uid": "scopedb-bluesky"
          },
          "modelVersion": 1,
          "queryText": "FROM bluesky_events\nWHERE $__timeFilter(time)\nSELECT CASE collection\n WHEN 'app.bsky.feed.post' THEN 'Posts'\n WHEN 'app.bsky.feed.like' THEN 'Likes'\n WHEN 'app.bsky.feed.repost' THEN 'Reposts'\n WHEN 'app.bsky.graph.follow' THEN 'Follows'\n ELSE collection END AS event_type\nGROUP BY event_type AGGREGATE count() AS events\nORDER BY events DESC\nLIMIT 10"
        }
      ]
    },
