      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "scopedb-scopedb-datasource",
        "uid": "scopedb-bluesky"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "scopedb-scopedb-datasource",
            "uid": "scopedb-bluesky"
          },
          "modelVersion": 1,
          "queryText": "FROM bluesky_events\nWHERE $__timeFilter(time)\nSELECT (time::int - time::int % 300000000000)::timestamp AS bucket, collection, operation\nGROUP BY bucket AGGREGATE\n sum(CASE (collection = 'app.bsky.feed.post' AND operation = 'create') WHEN true THEN 1 ELSE 0 END) AS posts,\n sum(CASE (collection = 'app.bsky.feed.like' AND operation = 'create') WHEN true THEN 1 ELSE 0 END) AS likes,\n sum(CASE (collection = 'app.bsky.feed.repost' AND operation = 'create') WHEN true THEN 1 ELSE 0 END) AS reposts,\n sum(CASE (collection = 'app.bsky.graph.follow' AND operation = 'create') WHEN true THEN 1 ELSE 0 END) AS follows\nSELECT bucket AS time, posts, likes, reposts, follows\nORDER BY time\nLIMIT 10000"
        }
      ]
    },
