      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "scopedb-scopedb-datasource",
            "uid": "scopedb-bluesky"
          },
          "modelVersion": 1,
          "queryText": "FROM bluesky_events\nWHERE $__timeFilter(time)\nSELECT (time::int - time::int % 300000000000)::timestamp AS bucket, (received_at - time)::int::float / 1000000.0 AS lag_ms\nGROUP BY bucket AGGREGATE\n approx_quantile(lag_ms, quantile => 0.5) AS p50_ms,\n approx_quantile(lag_ms, quantile => 0.95) AS p95_ms,\n approx_quantile(lag_ms, quantile => 0.99) AS p99_ms\nSELECT bucket AS time, p50_ms, p95_ms, p99_ms\nORDER BY time\nLIMIT 10000"
        }
      ]
