        {
          "refId": "A",
          "datasource": {
            "type": "scopedb-scopedb-datasource",
            "uid": "scopedb-bluesky"
          },
          "modelVersion": 1,
          "queryText": "FROM bluesky_events\nWHERE $__timeFilter(time)\nAND collection = 'app.bsky.feed.post' AND operation = 'create'\nSELECT CASE (language IS NULL OR language = '') WHEN true THEN 'Unspecified' ELSE language END AS language\nGROUP BY language AGGREGATE count() AS posts\nORDER BY posts DESC\nLIMIT 10"
        }
      ]
    },
