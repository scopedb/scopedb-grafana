      "datasource": {
        "type": "scopedb-scopedb-datasource",
        "uid": "scopedb-bluesky"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "scopedb-scopedb-datasource",
            "uid": "scopedb-bluesky"
          },
          "modelVersion": 1,
          "queryText": "FROM bluesky_events\nWHERE $__timeFilter(time)\nAGGREGATE count() AS events, sum(CASE (collection = 'app.bsky.feed.post' AND operation = 'create') WHEN true THEN 1 ELSE 0 END) AS posts,\n approx_count_distinct(actor_did) AS active_dids,\n approx_quantile((received_at - time)::int::float / 1000000.0, quantile => 0.95) AS p95_lag_ms"
        }
      ]
    },
