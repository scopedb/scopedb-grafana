{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "ScopeDB",
  "id": "scopedb-scopedb-datasource",
  "metrics": true,
  "backend": true,
  "executable": "gpx_scope_db",
  "info": {
    "description": "Connect Grafana to any ScopeDB workspace with ScopeQL, catalog discovery, variables, tables and time series.",
    "author": {
      "name": "Scopedb"
    },
    "keywords": [
      "scopedb",
      "scopeql",
      "datasource",
      "metrics"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": "13.1.0",
    "plugins": []
  },
  "logs": false,
  "alerting": false,
  "includes": [
    {
      "type": "dashboard",
      "name": "ScopeDB \u00b7 Getting started",
      "path": "dashboards/getting-started.json"
    }
  ]
}
